root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_size = 4
# The services use file-scoped namespaces and put the usings outside them
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

[*.md]
trim_trailing_whitespace = false

# EF Core writes the migrations, so they are not checked
[**/Migrations/*.cs]
generated_code = true
charset = unset
