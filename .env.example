# Copy to deploy/.env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=change-me
# RS256 key pair, each the base64 of a DER key on one line. Generate with deploy/generate-jwt-keys.sh
# The gateway and every service check tokens with the public key; only identity signs them with the private key.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Optional, Development only: creates this account so POST /api/auth/login can be tried. Leave empty to skip.
SEED_USER_NAME=
SEED_USER_PASSWORD=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
