# Copy to deploy/.env and fill in. Never commit the real .env.
POSTGRES_PASSWORD=change-me
SERVICE_DB_PASSWORD=change-me
RABBITMQ_USER=parking
RABBITMQ_PASSWORD=change-me
# RS256 public key (base64 of a DER key, one line). The gateway and every service use it to check tokens.
# deploy/generate-jwt-keys.sh prints a key pair; the private key is only needed by the service that signs tokens (not built yet).
JWT_PUBLIC_KEY=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
