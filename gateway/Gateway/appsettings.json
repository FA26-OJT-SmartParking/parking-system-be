{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Yarp": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "parking-identity"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/identity/auth/{**rest}"
        },
        "Order": -1,
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "identity": {
        "ClusterId": "identity",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/identity/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/identity"
          }
        ]
      },
      "parking-public": {
        "ClusterId": "parking",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/parking/lots/{**rest}",
          "Methods": [
            "GET"
          ]
        },
        "Order": -1,
        "Transforms": [
          {
            "PathRemovePrefix": "/api/parking"
          }
        ]
      },
      "parking": {
        "ClusterId": "parking",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/parking/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/parking"
          }
        ]
      },
      "parking-hub": {
        "ClusterId": "parking",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/hubs/{**rest}"
        }
      },
      "booking": {
        "ClusterId": "booking",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/booking/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/booking"
          }
        ]
      },
      "payment-ipn": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/payment/vnpay/ipn"
        },
        "Order": -1,
        "Transforms": [
          {
            "PathRemovePrefix": "/api/payment"
          }
        ]
      },
      "payment": {
        "ClusterId": "payment",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/payment/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/payment"
          }
        ]
      },
      "notification": {
        "ClusterId": "notification",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/notifications/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/notifications"
          }
        ]
      },
      "ai": {
        "ClusterId": "ai",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/ai/{**rest}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/ai"
          }
        ]
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity:8080/"
          }
        }
      },
      "parking": {
        "Destinations": {
          "d1": {
            "Address": "http://parking:8080/"
          }
        }
      },
      "booking": {
        "Destinations": {
          "d1": {
            "Address": "http://booking:8080/"
          }
        }
      },
      "payment": {
        "Destinations": {
          "d1": {
            "Address": "http://payment:8080/"
          }
        }
      },
      "notification": {
        "Destinations": {
          "d1": {
            "Address": "http://notification:8080/"
          }
        }
      },
      "ai": {
        "Destinations": {
          "d1": {
            "Address": "http://ai:8080/"
          }
        }
      }
    }
  }
}
